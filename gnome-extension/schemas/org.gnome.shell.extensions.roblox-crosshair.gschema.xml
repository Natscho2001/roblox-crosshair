<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.roblox-crosshair" path="/org/gnome/shell/extensions/roblox-crosshair/">
    <key name="visible" type="b">
      <default>true</default>
      <summary>Crosshair switched on (toggled by the shortcut / Quick Settings)</summary>
    </key>
    <key name="show-when" type="s">
      <choices>
        <choice value="always"/>
        <choice value="roblox-running"/>
        <choice value="roblox-focused"/>
      </choices>
      <default>'roblox-focused'</default>
      <summary>When to show it: always, while Roblox runs, or only while the Roblox window is focused</summary>
    </key>
    <key name="center-on" type="s">
      <choices>
        <choice value="monitor"/>
        <choice value="window"/>
      </choices>
      <default>'monitor'</default>
      <summary>Centre on the monitor (of the Roblox window, else the primary one) or on the Roblox window</summary>
    </key>
    <key name="shape" type="s">
      <choices>
        <choice value="dot"/>
        <choice value="cross"/>
        <choice value="cross-gap"/>
      </choices>
      <default>'cross-gap'</default>
      <summary>Shape</summary>
    </key>
    <key name="color" type="s">
      <default>'#39ff14'</default>
      <summary>Colour (#rrggbb)</summary>
    </key>
    <key name="size" type="d">
      <range min="1" max="500"/>
      <default>20</default>
      <summary>Total size in logical pixels (dot: diameter)</summary>
    </key>
    <key name="thickness" type="d">
      <range min="1" max="100"/>
      <default>2</default>
      <summary>Line thickness</summary>
    </key>
    <key name="gap" type="d">
      <range min="0" max="500"/>
      <default>6</default>
      <summary>Empty gap in the middle (cross-gap)</summary>
    </key>
    <key name="opacity" type="d">
      <range min="0" max="1"/>
      <default>1</default>
      <summary>Opacity 0..1</summary>
    </key>
    <key name="outline" type="b">
      <default>true</default>
      <summary>Draw a dark outline</summary>
    </key>
    <key name="outline-thickness" type="d">
      <range min="0" max="20"/>
      <default>1</default>
      <summary>Outline thickness</summary>
    </key>
    <key name="outline-color" type="s">
      <default>'#000000'</default>
      <summary>Outline colour (#rrggbb)</summary>
    </key>
    <key name="offset-x" type="d">
      <range min="-5000" max="5000"/>
      <default>0</default>
      <summary>Shift right (negative: left)</summary>
    </key>
    <key name="offset-y" type="d">
      <range min="-5000" max="5000"/>
      <default>0</default>
      <summary>Shift down (negative: up)</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default><![CDATA[['<Super><Alt>c']]]></default>
      <summary>Keyboard shortcut that toggles the crosshair</summary>
    </key>
    <key name="quick-toggle" type="b">
      <default>true</default>
      <summary>Show a toggle in the Quick Settings menu</summary>
    </key>
  </schema>
</schemalist>
